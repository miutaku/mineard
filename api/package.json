{
  "name": "mineard-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mineard",
    "db:migrate": "wrangler d1 execute mineard --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute mineard --local --file=src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "otpauth": "^9.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.124.0"
  }
}
